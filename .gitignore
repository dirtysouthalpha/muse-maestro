.env
.env.*
*.env
secrets.json
**/secrets.json
credentials.json
*.pem
*.key
id_rsa
id_rsa.*
auth.json

# Anything explicitly marked local (keeps private infra out of the public repo)
*.local.json
*local.json

# OS / editor noise
.DS_Store
*.swp
*~
node_modules/
